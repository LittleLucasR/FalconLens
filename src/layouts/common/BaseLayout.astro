---
// src/layouts/common/BaseLayout.astro
import type { ComponentProps } from 'astro/types';
import SEO from '../../components/SEO.astro';
import '../../styles/global.css';

// As props de SEO vêm direto do componente: se você adicionar uma lá, chega aqui sem retrabalho
type Props = ComponentProps<typeof SEO> & {
  bodyClass?: string;
};

const { bodyClass = '', ...seo } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="motion-safe:scroll-smooth scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {/* Título + description + canonical + OG + Twitter + theme-color */}
    <SEO {...seo} />

    {/* Ícones */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Extras da página: preload do hero, JSON-LD, analytics, etc. */}
    <slot name="head" />

    {/* Theme Toggle */}
    <script is:inline>
      const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      let theme = systemDark ? "dark" : "light";

      try {
        const saved = localStorage.getItem("theme");
        if (saved === "dark" || saved === "light") theme = saved;
      } catch {}

      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body
    class:list={[
      'min-h-dvh flex flex-col overflow-x-clip',
      'bg-surface text-foreground antialiased transition-colors',
      bodyClass,
    ]}
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-md"
    >
      Pular para o conteúdo principal
    </a>

    <slot />
  </body>
</html>