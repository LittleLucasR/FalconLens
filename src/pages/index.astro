---
// Importa os estilos globais com o Tailwind
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-br" class="h-full bg-slate-950 text-slate-100">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>FalconLens - Teste do Sistema</title>
  </head>
  <body class="flex min-h-screen items-center justify-center p-4 antialiased">
    
    <!-- Card de Teste do FalconLens -->
    <main class="max-w-md w-full rounded-2xl border border-slate-800 bg-slate-900/80 p-8 shadow-2xl backdrop-blur-md text-center">
      
      <!-- Badge Ativo -->
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-400 mb-6">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        FalconLens Core Active
      </div>

      <!-- Título com Gradiente -->
      <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Astro + <span class="bg-gradient-to-r from-sky-400 via-indigo-400 to-purple-500 bg-clip-text text-transparent">Tailwind CSS</span>
      </h1>
      
      <!-- Texto explicativo -->
      <p class="mt-4 text-sm text-slate-400 leading-relaxed">
        Se você está vendo um card escuro, com borda fina, texto com gradiente e um botão azul brilhante, <strong class="text-slate-200">o Tailwind está 100% configurado!</strong>
      </p>

      <!-- Botão com efeito Hover -->
      <div class="mt-8 flex justify-center">
        <button class="rounded-xl bg-sky-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-sky-500/20 transition-all hover:bg-sky-400 hover:scale-105 active:scale-95 cursor-pointer">
          Ecosistema Operacional 🚀
        </button>
      </div>

    </main>

  </body>
</html>