---
export type ContainerVariant = 'narrow' | 'default' | 'wide' | 'full';

interface Props {
  id?: string;
  class?: string;
  /** Se true, a secção ocupa pelo menos 100% da altura do ecrã (100dvh) */
  fullScreen?: boolean;
  /** Se true, envolve o conteúdo num contêiner com largura máxima padronizada */
  useContainer?: boolean;
  /** Variante da largura do contêiner interno */
  containerVariant?: ContainerVariant;
  /** Variante de fundo rápida */
  bg?: 'default' | 'muted' | 'dark' | 'brand';
}

const {
  id,
  class: className = '',
  fullScreen = false,
  useContainer = true,
  containerVariant = 'wide',
  bg = 'default'
} = Astro.props;

// Mapeamento de fundos padrão
const bgStyles = {
  default: 'bg-white text-neutral-900',
  muted: 'bg-neutral-100 text-neutral-900',
  dark: 'bg-neutral-900 text-white',
  brand: 'bg-blue-600 text-white',
};

// Mapeamento das variantes de largura do container
const containerStyles: Record<ContainerVariant, string> = {
  narrow: 'max-w-3xl',  // ~768px  (Textos longos, termos, formulários)
  default: 'max-w-5xl', // ~1024px (Padrão para seções institucionais)
  wide: 'max-w-7xl',    // ~1280px (Moderno: ideal para Hero, Grids e LPs)
  full: 'max-w-full',   // 100%    (Dashboards, galerias, sliders)
};
---

<section 
  id={id}
  class:list={[
    "w-full relative flex flex-col justify-center overflow-hidden",
    fullScreen ? "min-h-dvh py-12" : "py-16 md:py-24",
    bgStyles[bg],
    className
  ]}
>
  {useContainer ? (
    <div 
      class:list={[
        "w-full mx-auto px-4 sm:px-6 lg:px-8 flex flex-col justify-center flex-1",
        containerStyles[containerVariant]
      ]}
    >
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>